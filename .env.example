# PostgreSQL Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# POSTGRES_HOST / POSTGRES_PORT are set by docker-compose for the api service.
# Override them only when running the gateway outside Compose.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# LLM API (OpenAI-compatible chat completions endpoint)
OPENAI_API_KEY=
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# API Gateway
# Secret used to sign JWT access tokens. Generate e.g. with: openssl rand -hex 32
PROXY_SECRET_KEY=
# Optional overrides (defaults shown):
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
