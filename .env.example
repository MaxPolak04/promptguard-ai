# PostgreSQL Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# POSTGRES_HOST / POSTGRES_PORT are set by docker-compose for the api service.
# Override them only when running the gateway outside Compose.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# LLM API
OPENAI_API_KEY=

# API Gateway
PROXY_SECRET_KEY=
